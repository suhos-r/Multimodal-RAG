# --- Database / Vector / Cache / Blobs ---
# NOTE: REDIS_URL + S3_* are inert placeholders (no code path uses Redis or S3;
# cache is Postgres+memory, blobs are local disk). Kept so compose files stay valid.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rag-blobs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Auth ---
JWT_SECRET=change-me-to-32-plus-bytes-random-string
JWT_EXP_MIN=60
REFRESH_EXP_DAYS=14

# --- LLM (local Ollama, free) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
# Local dev: http://localhost:11434. Inside docker compose, Ollama runs on the
# HOST, so set OLLAMA_BASE_URL=http://host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://localhost:11434
# Optional cloud fallback (leave blank for fully-local):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings (local, free) ---
# nomic-embed-text via Ollama (768d). Pull once: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
RERANK_ENABLED=true

# --- RAG tuning (all read live) ---
TOP_K=8
RERANK_TOP_N=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHUNK_STRATEGY=recursive

# --- Repeat-query cache (all read live by services/cache.py) ---
SEM_CACHE_THRESHOLD=0.97
NEAR_DUP_LOW=0.90
CACHE_TTL_H=24

# --- Ingestion limits (read live) ---
MAX_UPLOAD_MB=100
WHISPER_MODEL=tiny
OCR_LANGS=eng

# --- Agent ---
AGENT_ENABLED=true
AGENT_MAX_ITERS=2

# --- Generation ---
ABSTAIN_TEXT=I don't know based on the knowledge base.
